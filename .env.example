# Copy to .env (git-ignored). Never put real keys in this file.

# Cerebras text model access for narrative reasoning (server/CLI side only).
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Optional explicit model id; empty = capability probe picks from the preference list.
CEREBRAS_MODEL=

# Where generated media, model caches, work dirs and packages live (outside git).
EPOCH_DATA_DIR=C:\Epoch\epoch-data

# CPU threads for faster-whisper (0 = physical cores).
EPOCH_ASR_THREADS=6
